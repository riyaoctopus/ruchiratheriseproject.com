# Copy this file to .env and fill in real values. .env is gitignored.

# Port the Express API server listens on (and that Vite's dev proxy targets).
PORT=4000

# Shared-secret for GET /api/leads/export?key=... — without this set, a new
# random key is generated every time the server restarts and printed to the
# console. Set a fixed value here so the export link stays stable.
LEADS_EXPORT_KEY=change-me-to-a-long-random-value
